{
  "skill_id": "assess-used-equipment-loan",
  "scenario": "S13",
  "direction": "MaintQ -> FinAllQ (FinAllQ가 내부적으로 InsuQ verify-collateral-insurance 2차 홉 재호출)",
  "description": "중고 설비 취득을 위한 담보 대출을 심사한다(S8의 중고 버전). 감정가·잔존연수를 반영하고, InsuQ 비례보상 결과로 조건부 승인 여부를 판정한다.",
  "request": {
    "type": "object",
    "required": ["requester", "request_chain_id", "loan_amount", "collateral_building_id", "equipment_year", "inspection_data"],
    "properties": {
      "requester": { "$ref": "#/definitions/requester" },
      "request_chain_id": { "type": "string" },
      "loan_amount": { "type": "number" },
      "collateral_building_id": { "type": "string" },
      "equipment_year": { "type": "integer", "description": "제조연도, 잔존연수 산정용" },
      "inspection_data": { "type": "object", "description": "실사 데이터(중고 설비 실사, S18 verify_ownership 결과 참조 가능)" }
    }
  },
  "response": {
    "type": "object",
    "required": ["status", "decision", "collateral_check"],
    "properties": {
      "status": { "type": "string", "enum": ["completed"] },
      "appraised_value": { "type": "number" },
      "decision": { "type": "string", "enum": ["approved", "conditional", "rejected"] },
      "condition_note": { "type": "string" },
      "collateral_check": {
        "type": "object",
        "description": "InsuQ verify-collateral-insurance 응답(비례보상 포함) 요약",
        "properties": {
          "coverage_amount": { "type": "number" },
          "insured_value": { "type": "number" },
          "effective_recovery": { "type": "number" },
          "sufficient": { "type": "boolean" }
        }
      },
      "market_context": {
        "type": ["object", "null"],
        "description": "FinAllQ 내부 참고 데이터. A2A 계약상 필수 아님 — 없으면 null.",
        "properties": {
          "esg_rating": { "type": ["string", "null"] },
          "stock_price_snapshot": {
            "type": ["object", "null"],
            "properties": {
              "as_of": { "type": "string", "format": "date" },
              "price": { "type": "number" },
              "volatility_30d_pct": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "requester": {
      "type": "object",
      "required": ["finallq_company_id"],
      "properties": {
        "finallq_company_id": { "type": "string" },
        "building_id": { "type": "string" },
        "policy_id": { "type": "string" }
      }
    }
  }
}
